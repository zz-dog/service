# /etc/systemd/system/service.service
# 安装：cp service.service /etc/systemd/system/ && systemctl daemon-reload
# 启动：systemctl enable --now service
# 日志：journalctl -u service -f

[Unit]
Description=Demo Service API (Go / DDD)
After=network.target mysql.service

[Service]
Type=simple
User=root
# 工作目录必须是二进制所在目录，Viper 从相对路径 config/config.yaml 读取配置
WorkingDirectory=/opt/service
ExecStart=/opt/service/service
Restart=always
RestartSec=5

# 基础加固
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
